; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Protektor: Children of the Void"
config/version="0.12.1"
run/main_scene="res://scenes/shell.tscn"
config/features=PackedStringArray("4.6")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.086, 0.075, 0.122, 1)
boot_splash/use_filter=false
boot_splash/image="res://boot_splash.png"
config/icon="res://icon.png"

[autoload]

Art="*res://scripts/art.gd"
Sfx="*res://scripts/sfx.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.086, 0.075, 0.122, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
