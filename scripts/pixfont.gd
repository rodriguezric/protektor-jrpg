static func build() -> FontFile:
	var keys := GLYPHS.keys()
	var cols := 16
	var rows := ceili(keys.size() / float(cols))
	var atlas := Image.create_empty(cols * CELL.x, rows * CELL.y, false, Image.FORMAT_RGBA8)
	var f := FontFile.new()
	var sz := Vector2i(SIZE, 0)
	f.fixed_size = SIZE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.allow_system_fallback = false
	f.set_cache_ascent(0, SIZE, ASCENT)
	f.set_cache_descent(0, SIZE, SIZE - ASCENT)
	for i in keys.size():
		var ch: String = keys[i]
		var lines: PackedStringArray = (GLYPHS[ch] as String).split("|")
		var gw := 0
		for ln in lines:
			gw = maxi(gw, ln.length())
		var ax := (i % cols) * CELL.x
		var ay := (i / cols) * CELL.y
		for y in lines.size():
			for x in lines[y].length():
				if lines[y][x] == "#":
					atlas.set_pixel(ax + x, ay + y, Color.WHITE)
		var cp := ch.unicode_at(0)
		f.set_glyph_advance(0, SIZE, cp, Vector2(gw + 1, 0))
		f.set_glyph_offset(0, sz, cp, Vector2(0, -ASCENT))
		f.set_glyph_size(0, sz, cp, Vector2(gw, CELL.y))
		f.set_glyph_uv_rect(0, sz, cp, Rect2(ax, ay, gw, CELL.y))
		f.set_glyph_texture_idx(0, sz, cp, 0)
	var sp := " ".unicode_at(0)
	f.set_glyph_advance(0, SIZE, sp, Vector2(3, 0))
	f.set_glyph_size(0, sz, sp, Vector2.ZERO)
	f.set_texture_image(0, sz, 0, atlas)
	return f
