#!/usr/bin/env bash
# Play a single mission straight away, for testing levels.
#
#   ./run_mission viscera_nova_level_01            # with the warp-in intro
#   ./run_mission viscera_nova_level_01 --no-intro # skip the intro
#   ./run_mission training_block_2                 # a training drill (block|shoot|combo, tier 1-3)
#   ./run_mission tempestris_level_03 --weapon=beam --cooldown=3 --armor=2 --missile --shield
#   ./run_mission tempestris_level_03 --upgrades=max --weapon=auto
#   ./run_mission                                  # list the missions
#
# Weapons: basic, wave, beam, auto.
#
# Win or lose, the mission restarts. Esc > "Abort mission" quits.
# Nothing is written to your save file.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GODOT="${GODOT:-godot}"

if [[ $# -lt 1 ]]; then
	echo "usage: ./run_mission <mission_name> [--no-intro] [--weapon=basic|wave|beam|auto] [--cooldown=0-3] [--armor=0-3] [--missile] [--shield] [--upgrades=max]"
	echo
	echo "missions:"
	for f in "$DIR"/data/missions/*.json; do
		echo "  $(basename "$f" .json)"
	done
	echo "  training_{block,shoot,combo}_{1,2,3}"
	exit 1
fi

NAME="${1%.json}"
shift
if [[ ! "$NAME" =~ ^training_(block|shoot|combo)_[123]$ && ! -f "$DIR/data/missions/$NAME.json" ]]; then
	echo "no mission named '$NAME' (looked for data/missions/$NAME.json)" >&2
	echo "run ./run_mission with no arguments to list them" >&2
	exit 1
fi

INTRO="on"
EXTRA=()
for a in "$@"; do
	if [[ "$a" == "--no-intro" ]]; then
		INTRO="off"
	else
		EXTRA+=("$a")
	fi
done

exec "$GODOT" --path "$DIR" -- --mission="$NAME" --intro="$INTRO" "${EXTRA[@]}"
